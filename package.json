{
  "name": "mtg-deck-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ci": "vitest run --coverage",
    "test:e2e": "testcafe chrome:headless tests/e2e/**/*.test.ts",
    "test:e2e:smoke": "testcafe chrome:headless tests/e2e/deck-create.test.ts",
    "test:e2e:mobile": "testcafe \"chrome:headless:emulation:device=iphone X\" tests/e2e/**/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration",
    "prepare": "husky"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "$sharp"
  },
  "dependencies": {
    "@serwist/next": "9.5.12",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.32.0",
    "next": "15.5.23",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "9.5.12",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "testcafe": "^3.7.6",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
