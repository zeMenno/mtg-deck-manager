# Copy to .env.local for local development. No secrets are required for MVP —
# deck data is local-first and Scryfall's public API needs no key.
# Production names (no values): see .env.production.example

# Absolute origin of the running app. Used for metadata and the PWA manifest.
# Set this per environment in the Vercel dashboard for Production / Preview.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: route Scryfall search/detail through /api/cards/* (server User-Agent).
# Default is direct browser CORS to api.scryfall.com.
# NEXT_PUBLIC_USE_SCRYFALL_PROXY=true

# Do NOT put price-provider or other secrets in NEXT_PUBLIC_* variables.
