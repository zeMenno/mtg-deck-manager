# Copy to .env.local for local development. No secrets are required in Phase 1 —
# deck data is local-first and Scryfall's public API needs no key.

# Absolute origin of the running app. Used for metadata and, from Phase 2, the
# PWA manifest. Set this per environment in the Vercel dashboard.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: route Scryfall search/detail through /api/cards/* (server User-Agent).
# Default is direct browser CORS to api.scryfall.com.
# NEXT_PUBLIC_USE_SCRYFALL_PROXY=true
